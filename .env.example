# AiApiTest-DWP 公共部署配置
# 本模板只保存网络入口和必要运维选项；账号、密码、Token、密钥及内部 SCM 配置仅存在于本地私有 .env。
# 修改端口或公开入口后，需要通过固定 Platform Bootstrap Job 重建并验收应用服务。

# === 平台网络 ===
# 所有宿主机端口的监听地址，填写不带方括号的 IPv4/IPv6。127.0.0.1 仅允许本机访问；需要局域网访问时可改为 0.0.0.0。
PLATFORM_BIND_HOST=127.0.0.1
# 浏览器和命令行实际访问的平台主机，只填写域名、IPv4 或 IPv6，不包含协议、端口和路径；IPv6 可省略方括号。
PLATFORM_PUBLIC_HOST=127.0.0.1
# 对外链接协议，仅允许 http 或 https；https 需要由外部 TLS 入口提供证书和转发。
PLATFORM_PUBLIC_SCHEME=http

# === 宿主机端口 ===
# MySQL 对外端口；容器内部始终使用 mysql:3306。
MYSQL_HOST_PORT=3307
# Jenkins Web 对外端口；容器内部始终使用 jenkins:8080。
JENKINS_HTTP_PORT=8080
# Jenkins inbound agent 对外端口；容器内部始终使用 50000。
JENKINS_AGENT_PORT=50001
# DRF backend 对外端口；容器内部始终使用 backend:8000。
BACKEND_HOST_PORT=8000
# Vue frontend 对外端口；容器内部始终使用 frontend:80。
FRONTEND_HOST_PORT=5173

# === 必要运维选项 ===
# Compose 挂载的仓库根目录。模板使用当前目录；本地 .env 可改为当前机器的实际绝对路径。
PROJECT_WORKSPACE=.
# Docker Socket 所属组的 GID；Linux 按宿主机实际值填写，Docker Desktop 通常可保持 0。
DOCKER_GID=0
# Jenkins 构建记录和本地 CI 报告保留天数，影响 Job buildDiscarder 与报告清理。
CI_RUN_RETENTION_DAYS=30
# 前端测试镜像的 Playwright 基础镜像；仅在镜像源或版本兼容需要调整时修改。
FRONTEND_PLAYWRIGHT_BASE_IMAGE=mcr.m.daocloud.io/playwright:v1.61.1-noble

# 私有凭据不在可提交模板中列出。首次复制后必须按部署文档补齐本地 .env 私有区，才能启动基础服务。

# === 私有配置（仅本地） ===
