# AiApiTest-DWP 通用网络与服务入口配置模板
# 说明：本文件只保留 IP、端口、服务 URL、本机挂载路径等通用可变配置。
# 账号、密码、密钥、Cookie 策略、数据库名、初始化管理员等私有或固定配置不写入本文件。
# 本地验收请在不提交的 .env 中补齐这些私有配置。

# === MySQL 宿主机访问配置 ===
# MYSQL_BIND_HOST：MySQL 暴露到宿主机的绑定 IP，本机验收默认只监听 127.0.0.1。
# MYSQL_HOST_PORT：MySQL 暴露到宿主机的端口，启动容器并产生连接后不建议随意修改。
# MYSQL_HOST：后端在宿主机运行时访问 MySQL 的主机名或 IP。
MYSQL_BIND_HOST=127.0.0.1
MYSQL_HOST_PORT=3307
MYSQL_HOST=127.0.0.1

# === Jenkins 服务入口配置 ===
# JENKINS_HTTP_PORT：Jenkins Web 入口端口，已产生任务链接后不建议随意修改。
# JENKINS_AGENT_PORT：Jenkins agent 通信端口，已配置 agent 后不建议随意修改。
# JENKINS_PUBLIC_BASE_URL：前后端展示和跳转 Jenkins 时使用的公开访问地址。
# JENKINS_API_BASE_URL：后端触发、取消和同步 Jenkins 时使用的内部访问地址；Compose 内可改为 http://jenkins:8080。
# JENKINS_FAILED_RERUN_JOB_NAME / JENKINS_MODULE_RERUN_JOB_NAME：后端初始化 Job 映射时可使用的默认 Job 名。
# JENKINS_DAILY_FULL_JOB_PREFIX：每日全量每模块一个 Job 时的命名前缀，实际绑定以后端 jenkins_job_binding 为准。
# JENKINS_REQUEST_TIMEOUT_SECONDS：后端调用 Jenkins API 的单次请求超时。
# JENKINS_QUEUE_POLL_INTERVAL_SECONDS / JENKINS_BUILD_POLL_INTERVAL_SECONDS：后台同步建议轮询间隔。
# JENKINS_BUILD_POLL_TIMEOUT_SECONDS：单个构建最长轮询时间。
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50001
JENKINS_PUBLIC_BASE_URL=http://localhost:8080
JENKINS_API_BASE_URL=http://127.0.0.1:8080
JENKINS_FAILED_RERUN_JOB_NAME=AiApiTest-DWP-Failed-Rerun
JENKINS_MODULE_RERUN_JOB_NAME=AiApiTest-DWP-Module-Rerun
JENKINS_DAILY_FULL_JOB_PREFIX=AiApiTest-DWP-Daily-Full-Module
JENKINS_REQUEST_TIMEOUT_SECONDS=15
JENKINS_QUEUE_POLL_INTERVAL_SECONDS=5
JENKINS_BUILD_POLL_INTERVAL_SECONDS=10
JENKINS_BUILD_POLL_TIMEOUT_SECONDS=1800

# === 项目工作区挂载配置 ===
# PROJECT_WORKSPACE：Jenkins 容器挂载项目源码时使用的宿主机路径，必须指向当前正在开发和验收的仓库根目录。
# 若该路径指向旧工作区，Jenkins 会加载旧代码，即使当前仓库已经提交和推送也不会生效。
# LOCAL_WORKSPACE_REPO：本地 Compose Jenkins 使用挂载仓库执行，避免验收时依赖远端源码网络。
# AIAPITEST_LOCAL_WORKSPACE：Jenkins 容器内项目挂载点，应与 docker-compose.yml volume 目标路径一致。
# AIAPITEST_REPLACE_EXISTING_LOCAL_JOBS：显式为 true 时，允许本地配置脚本覆盖已有本地 Job。
# CI_RUN_RETENTION_DAYS：Jenkins/api-test 本地运行报告保留天数，默认只删除超过该天数的 runtime 历史目录。
LOCAL_WORKSPACE_REPO=true
AIAPITEST_LOCAL_WORKSPACE=/workspace/AiApiTest-DWP
AIAPITEST_REPLACE_EXISTING_LOCAL_JOBS=false
PROJECT_WORKSPACE=.
CI_RUN_RETENTION_DAYS=30

# === 后端服务入口配置 ===
# BACKEND_SERVICE_URL：DRF 后端服务根地址，供文档、联调和前端代理引用。
# BACKEND_API_BASE_URL：DRF API v1 完整入口地址，供验收脚本或外部调用方引用。
BACKEND_SERVICE_URL=http://127.0.0.1:8000
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api/v1

# === 前端开发服务与 API 代理配置 ===
# FRONTEND_SERVICE_URL：Vue 前端开发服务访问地址。
# FRONTEND_DEV_HOST：Vite dev server 监听 IP。
# FRONTEND_DEV_PORT：Vite dev server 监听端口。
# FRONTEND_DEV_API_PROXY_TARGET：Vite 开发代理转发到后端的目标地址。
# VITE_API_BASE_URL：浏览器端 Axios 使用的 API 基础路径；客户端可见变量必须使用 VITE_ 前缀。
# VITE_API_TIMEOUT_MS：前端请求超时时间，单位毫秒。
FRONTEND_SERVICE_URL=http://127.0.0.1:5173
FRONTEND_DEV_HOST=127.0.0.1
FRONTEND_DEV_PORT=5173
FRONTEND_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=10000

# === Playwright 验收入口配置 ===
# PLAYWRIGHT_WEB_SERVER_HOST：Playwright 启动或等待前端预览服务时使用的监听 IP。
# PLAYWRIGHT_WEB_SERVER_PORT：Playwright 前端预览服务端口。
# PLAYWRIGHT_BASE_URL：Playwright 用例访问前端页面的基准地址。
PLAYWRIGHT_WEB_SERVER_HOST=127.0.0.1
PLAYWRIGHT_WEB_SERVER_PORT=4173
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
